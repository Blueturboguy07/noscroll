{
  "version": 2,
  "minEngine": 1,
  "services": {
    "youtube": {
      "match": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*"
      ],
      "authAllowList": [
        "^/signin",
        "^/logout",
        "^/ServiceLogin"
      ],
      "surfaces": {
        "shorts-route": {
          "kind": "route-block",
          "label": "Block Shorts",
          "patterns": [
            "^/shorts(/|\\?|$)"
          ],
          "redirect": "/",
          "source": "The Shorts tab of m.youtube.com opens /shorts/ with no video id; a Shorts link opens /shorts/<id>. Both go home, also when the page changes the address in place (pushState).",
          "defaultEnabled": true
        },
        "shorts-shelf": {
          "kind": "dom-remove",
          "label": "Block Shorts shelf",
          "selectors": [
            "ytd-rich-shelf-renderer[is-shorts]",
            "ytd-reel-shelf-renderer",
            "ytm-reel-shelf-renderer",
            "grid-shelf-view-model:has(a[href^='/shorts'])",
            "ytd-rich-section-renderer:has(a[href^='/shorts'])",
            "ytm-rich-section-renderer:has(a[href^='/shorts'])",
            "ytd-video-renderer:has(a[href^='/shorts'])",
            "ytm-video-with-context-renderer:has(a[href^='/shorts'])",
            "ytm-rich-item-renderer:has(ytm-shorts-lockup-view-model)",
            "grid-shelf-view-model:has(ytm-shorts-lockup-view-model)",
            "ytm-rich-section-renderer:has(ytm-shorts-lockup-view-model)",
            "ytm-shorts-lockup-view-model"
          ],
          "observe": true,
          "probe": {
            "expectMin": 0,
            "warnIfZeroFor": "6h"
          },
          "source": "seeded from gijsdev/ublock-hide-yt-shorts (MIT)",
          "defaultEnabled": true
        },
        "shorts-nav": {
          "kind": "dom-remove",
          "label": "Remove Shorts tab",
          "selectors": [
            "ytm-pivot-bar-item-renderer:has(.pivot-bar-item-tab[class*='shorts'])",
            "ytm-pivot-bar-item-renderer:has(.pivot-bar-item-tab.pivot-shorts)",
            "ytm-pivot-bar-item-renderer:has(.pivot-shorts)",
            "ytd-mini-guide-entry-renderer:has(a[title='Shorts'])",
            "ytd-guide-entry-renderer:has(a[href='/shorts'])",
            "ytm-pivot-bar-item-renderer:has(div[aria-label='Shorts'])",
            "ytm-pivot-bar-item-renderer:has(a[href^='/shorts'])",
            "a.pivot-shorts",
            "[role='tab'][aria-label='Shorts']"
          ],
          "afterRemove": "rejustify",
          "observe": true,
          "probe": {
            "expectMin": 1,
            "onlyWhenSignedIn": true
          },
          "defaultEnabled": true
        },
        "create-nav": {
          "kind": "dom-remove",
          "defaultEnabled": true,
          "label": "Remove Create tab",
          "selectors": [
            "ytm-pivot-bar-item-renderer:has([aria-label='Create'])",
            "ytd-button-renderer:has(a[href='/upload'])"
          ],
          "afterRemove": "rejustify",
          "observe": true,
          "probe": {
            "expectMin": 0
          }
        },
        "up-next": {
          "kind": "dom-remove",
          "defaultEnabled": true,
          "label": "Hide up-next & recommended",
          "selectors": [
            "ytd-watch-next-secondary-results-renderer",
            "ytm-item-section-renderer[section-identifier='related-items']",
            "#related",
            "ytd-compact-video-renderer"
          ],
          "onlyOnRoutes": [
            "^/watch"
          ],
          "observe": true,
          "probe": {
            "expectMin": 1,
            "onlyOnRoutes": [
              "^/watch"
            ]
          },
          "source": "Hides the up-next list and the recommendations on a watch page, so one video does not lead into the next."
        },
        "home-feed": {
          "kind": "dom-remove",
          "defaultEnabled": false,
          "label": "Block home feed",
          "selectors": [
            "ytd-rich-grid-renderer",
            "ytm-rich-grid-renderer"
          ],
          "onlyOnRoutes": [
            "^/$",
            "^/\\?"
          ],
          "observe": true,
          "probe": {
            "expectMin": 0
          }
        },
        "trending": {
          "kind": "route-block",
          "defaultEnabled": true,
          "label": "Block Trending & Explore",
          "patterns": [
            "^/feed/trending",
            "^/feed/explore"
          ],
          "redirect": "/feed/subscriptions"
        },
        "grayscale": {
          "kind": "style",
          "defaultEnabled": false,
          "label": "Grayscale",
          "css": "html { filter: grayscale(1) !important; }"
        }
      },
      "signedOutWhen": [
        "a[href*='accounts.google.com/ServiceLogin']",
        "a[href*='/signin']"
      ]
    }
  },
  "signature": "g11YmZC1qNIjUIEORZJUGZbvnuYtT4OUxY7JxveFzF2wFmBdvkatUEhf10ZiEREp8qWXaHBEUZhHDInfKtu5CQ=="
}
