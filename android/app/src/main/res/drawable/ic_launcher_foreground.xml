<?xml version="1.0" encoding="utf-8"?>
<!--
  A scrollbar thumb parked at the bottom of its track: there is no more.

  Vector, not PNG: minSdk is 26, so adaptive icons are always available and no
  legacy density bitmaps are needed. Geometry matches the iOS icon exactly —
  the 100x100 design is mapped into the central 72dp safe zone of the 108dp
  adaptive canvas, so nothing is clipped by any launcher mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- track -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.26"
        android:pathData="M44.64,38.88 A9.36,9.36 0 0 1 63.36,38.88 L63.36,69.12 A9.36,9.36 0 0 1 44.64,69.12 Z" />

    <!-- thumb, flush with the bottom of the track -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47.52,64.8 A6.48,6.48 0 0 1 60.48,64.8 L60.48,69.12 A6.48,6.48 0 0 1 47.52,69.12 Z" />
</vector>
